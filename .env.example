# Copy to .env and fill in. Never commit .env.
# Every value here is a placeholder. Generate secrets with: openssl rand -hex 32

# --- Service ---
DATABASE_URL=postgresql+psycopg://identity_lifecycle:change-me@localhost:5432/identity_lifecycle
LIFECYCLE_MASTER_KEY=replace-with-64-hex-chars
LOG_LEVEL=INFO

# --- LiteLLM gateway ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-replace-me
LITELLM_DATABASE_URL=postgresql://litellm:change-me@localhost:5432/litellm
OPENAI_API_KEY=sk-replace-me

# --- Active Directory (read-only service account) ---
AD_SERVER=ldaps://dc.example.com:636
AD_BIND_DN=CN=svc-identity-read,OU=Service Accounts,DC=corp,DC=example,DC=com
AD_BIND_PASSWORD=replace-me
AD_CA_CERT_PATH=/etc/ssl/certs/corp-ca.pem

# --- Okta (read-only scopes) ---
OKTA_ORG_URL=https://example.okta.com
OKTA_CLIENT_ID=replace-me
OKTA_KEY_ID=replace-me
OKTA_PRIVATE_KEY_PATH=/run/secrets/okta-private-key.pem
